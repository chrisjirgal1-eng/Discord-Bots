# Copy this file to .env and fill in your values. .env is gitignored.

# Discord bot: from Discord Developer Portal, Bot, Token
DISCORD_TOKEN=your_token_here

# Optional: your test server's ID for instant slash command sync.
# Leave empty to sync globally (takes about an hour to propagate).
DEV_GUILD_ID=

# Groq Whisper, for the video transcription pipeline (tools/watch_batch.py)
GROQ_API_KEY=your_groq_key_here

# JARVIS voice. The Voice ID is the ElevenLabs voice (public, not secret).
# Lily works on the free tier. Add your ElevenLabs API key to make her talk back via
# tools/jarvis_speak.py. Deepgram is for listening (the full two-way loop).
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
ELEVENLABS_API_KEY=your_elevenlabs_key_here
DEEPGRAM_API_KEY=your_deepgram_key_here

# ZOE speech-to-speech mode (tools/zoe_realtime.py): OpenAI Realtime is her ears, brain,
# and mouth in one model, with her PC powers wired in as tools. This is the demo-grade
# voice. It is metered per audio token, so she idles in a cheap local wake-listen and only
# opens the paid session while you actually talk, then closes it after ZOE_REALTIME_IDLE_SEC.
OPENAI_API_KEY=your_openai_key_here
ZOE_REALTIME_MODEL=gpt-realtime          # override if OpenAI's GA model id changes
ZOE_REALTIME_VOICE=marin                 # realtime voice (marin, cedar, ...), not Lily
ZOE_REALTIME_IDLE_SEC=120                # stay open (responsive, no wake word) until this much
                                         # silence; say "go to sleep" to stand her down sooner
# ZOE_REALTIME_MAX_MIN=                   # optional hard per-session minute cap
# ZOE_REALTIME_GATE=                      # wake (default w/ Deepgram) | manual (Enter) | always

# Multi-account browsing. ZOE opens sites signed in as one of your Chrome profiles -- no
# passwords are ever stored or typed; Chrome holds the login. Map account name = profile folder.
# Find a profile's folder name at chrome://version ("Profile Path", e.g. Default or "Profile 1").
# ZOE_BROWSER_PROFILES=personal=Default; zenthra=Profile 1; clearcoat=Profile 2
# ZOE_CHROME=                             # full path to chrome.exe, only if auto-detect fails

# Cinematic background music (her JARVIS-style rundown). Point this at YOUR own epic track
# (mp3/m4a/wav) -- not shipped here. She loops it ducked under her voice until you say stop.
# ZOE_MUSIC=C:\Users\chris\Music\epic.mp3
# ZOE_MUSIC_GAIN=0.25                     # how loud the music sits under her voice (0-1)

# Browser agent (she clicks/types/navigates real sites). Logins persist in a dedicated profile
# under ~/.zoe-browser -- sign into your accounts once in that window. She confirms before any
# irreversible action (post/send/buy/delete/submit). Setup: pip install playwright; playwright
# install chromium. Optional knobs:
# ZOE_BROWSER_HEADLESS=0                  # 1 to hide the window (default visible)
# ZOE_BROWSER_EXECUTABLE=                 # path to a specific chrome/chromium, if needed
