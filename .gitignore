# graphify generated artifacts. Keep the queryable graph + report so future
# sessions query without re-running semantic extraction. Ignore the rest.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md

# Python
__pycache__/
*.pyc
.venv/
venv/

# Tests
tests/__pycache__/
.coverage

# Voice audio artifacts (TTS test clips)
*.mp3
*.wav

# Node / Electron
node_modules/
dist/
out/
package-lock.json

# Zoe runtime session state (generated; not committed)
memory/zoe_state.json
memory/*.tmp

# Obsidian memory vault: keep curated notes + README, ignore runtime churn
vault/index.md
vault/sessions/
vault/log/
.obsidian/

# External skill packs: installed locally, documented in .claude/skills/EXTERNAL-SKILLS.md,
# not vendored into git (large third-party content with their own repos/licenses)
.claude/skills/three-best-practices/
.claude/skills/r3f-best-practices/
.claude/skills/ui-ux-pro-max/
.claude/skills/design/
.claude/skills/design-system/
.claude/skills/ui-styling/

# Env and secrets
.env
.env.local

# Local-only Claude notes
CLAUDE.local.md

# Scaffolded separate project (prompts.chat platform). Belongs in its own repo,
# not committed here. Regenerable via `npx prompts.chat new`. 127MB + secrets.
my-prompt-library/
vault/system/
vault/docs/
vault/project/
vault/skills/
vault/plugins/
