# graphify generated artifacts. Keep the queryable graph + report so future
# sessions query without re-running semantic extraction. Ignore the rest.
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md

# Python
__pycache__/
*.pyc
.venv/
venv/

# Tests
tests/__pycache__/
.coverage

# Voice audio artifacts (TTS test clips)
*.mp3
*.wav

# Env and secrets
.env
.env.local

# Local-only Claude notes
CLAUDE.local.md

# Scaffolded separate project (prompts.chat platform). Belongs in its own repo,
# not committed here. Regenerable via `npx prompts.chat new`. 127MB + secrets.
my-prompt-library/
